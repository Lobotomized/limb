{
  "name": "limb-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Top-down physics fighting game where every limb has its own health.",
  "main": "electron/main.cjs",
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "pixi.js": "^8.23.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "eslint-plugin-boundaries": "^7.4.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "vite-node server/signaling.ts",
    "electron:dev": "vite build && electron .",
    "dist": "vite build && electron-builder --config electron/builder.config.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sim:bots": "vite-node tools/sim-bots.ts --",
    "sim:determinism": "vite-node tools/sim-determinism.ts --",
    "sim:net": "vite-node tools/sim-net.ts --",
    "sim:parts": "vite-node tools/sim-parts.ts --"
  }
}
